# ==============================================================================
# Windows Log Collector Configuration
# ==============================================================================

# NestJS Backend API Base URL
BACKEND_URL=http://localhost:3001

# Polling interval in seconds (used in --watch mode)
COLLECTOR_INTERVAL=10

# Hostname identifier for this machine
COLLECTOR_HOSTNAME=laptop-windows

# Device type metadata
DEVICE_TYPE=Windows Laptop

# Authentication credentials for NestJS API (ADMIN or ANALYST role required)
COLLECTOR_USERNAME=admin@cti.com
COLLECTOR_PASSWORD=Admin@123

# Maximum events to collect per channel per polling run
BATCH_SIZE=50
